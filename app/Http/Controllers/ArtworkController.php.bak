<?php

namespace App\Http\Controllers;

use App\Http\Requests\StoreArtworkRequest;
use App\Http\Requests\UpdateArtworkRequest;
use App\Models\Artist;
use App\Models\Artwork;
use App\Models\Location;
use App\Models\Movement;
use App\Services\ImageOptimizer;
use Illuminate\Http\Response;
use Illuminate\Http\RedirectResponse;
use Illuminate\Http\JsonResponse;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Storage;
use Illuminate\Support\Str;
use Throwable;
use Illuminate\View\View;
use Barryvdh\DomPDF\Facade\Pdf;

class ArtworkController extends Controller
{
    private ?string $lastPdfError = null;

    public function __construct(private readonly ImageOptimizer $imageOptimizer)
    {
    }

    public function index(Request $request): View
    {
        $q = trim((string) $request->string('q'));
        $qLower = Str::lower($q);
        $selectedRegion = trim((string) $request->string('region'));
        $selectedStatus = trim((string) $request->string('status'));
        $view = in_array((string) $request->string('view'), ['grid', 'table'], true)
            ? (string) $request->string('view')
            : 'grid';

        $regionOptions = Artist::query()
            ->whereNotNull('country')
            ->where('country', '!=', '')
            ->orderBy('country')
            ->pluck('country')
            ->unique()
            ->values();

        $statusOptions = Artwork::query()
            ->whereNotNull('status')
            ->where('status', '!=', '')
            ->distinct()
            ->orderBy('status')
            ->pluck('status');

        $artworks = Artwork::query()
            ->with(['artist', 'location'])
            ->when($q !== '', function ($query) use ($qLower) {
                $query->where(function ($inner) use ($qLower) {
                    $like = "%{$qLower}%";
                    $inner->whereRaw('LOWER(title) LIKE ?', [$like])
                        ->orWhereRaw('LOWER(medium) LIKE ?', [$like])
                        ->orWhereHas('artist', fn ($artistQuery) => $artistQuery->whereRaw('LOWER(name) LIKE ?', [$like]));
                });
            })
            ->when($selectedRegion !== '', fn ($query) => $query->whereHas('artist', fn ($artistQuery) => $artistQuery->where('country', $selectedRegion)))
            ->when($selectedStatus !== '', fn ($query) => $query->where('status', $selectedStatus))
            ->latest()
            ->paginate(24)
            ->withQueryString();

        return view('artworks.index', compact(
            'artworks',
            'q',
            'selectedRegion',
            'selectedStatus',
            'regionOptions',
            'statusOptions',
            'view'
        ));
    }

    public function create(): View
    {
        return view('artworks.create');
    }
	
	public function exportPdf(Request $request)
	{
		@ini_set('memory_limit', '512M');
		@set_time_limit(300);

		$view = in_array((string) $request->string('view'), ['grid', 'table'], true)
			? (string) $request->string('view')
			: 'grid';

		$q = trim((string) $request->string('q'));
		$qLower = Str::lower($q);
		$selectedRegion = trim((string) $request->string('region'));
		$selectedStatus = trim((string) $request->string('status'));
		$limit = 100;

		$artworks = Artwork::query()
			->with([
				'artist',
				'images:id,artwork_id,path,position',
			])
			->when($q !== '', function ($query) use ($qLower) {
				$query->where(function ($inner) use ($qLower) {
					$like = "%{$qLower}%";
					$inner->whereRaw('LOWER(title) LIKE ?', [$like])
						->orWhereRaw('LOWER(medium) LIKE ?', [$like])
						->orWhereHas('artist', fn ($artistQuery) =>
							$artistQuery->whereRaw('LOWER(name) LIKE ?', [$like])
						);
				});
			})
			->when($selectedRegion !== '', fn ($query) =>
				$query->whereHas('artist', fn ($artistQuery) =>
					$artistQuery->where('country', $selectedRegion)
				)
			)
			->when($selectedStatus !== '', fn ($query) =>
				$query->where('status', $selectedStatus)
			)
			->latest()
			->limit($limit)
			->get();

		$viewData = [
            'artworks' => $artworks,
            'view' => $view,
            'exportedAt' => now(),
        ];

		$filename = 'artworks-' . now()->format('Ymd-His') . '.pdf';
		$html = view('artworks.pdf', $viewData)->render();

		$chromePdf = null;

		try {
			$chromePdf = $this->renderPdfWithChrome($html);
		} catch (\Throwable $e) {
			\Log::warning('Chrome PDF render failed, falling back to DomPDF', [
				'message' => $e->getMessage(),
			]);
		}

		if ($chromePdf !== null) {
			return response($chromePdf, 200, [
				'Content-Type' => 'application/pdf',
				'Content-Disposition' => 'attachment; filename="' . $filename . '"',
				'Content-Length' => (string) strlen($chromePdf),
			]);
		}

		$pdf = Pdf::loadView('artworks.pdf', $viewData)
			->setPaper('a4', $view === 'grid' ? 'landscape' : 'portrait');

		return $pdf->download($filename);
	}

